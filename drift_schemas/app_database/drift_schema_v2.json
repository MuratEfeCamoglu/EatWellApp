    {
      "name": "food_log_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"food_log_entries\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"synced_at\" INTEGER NULL, \"server_updated_at\" INTEGER NULL, \"date\" TEXT NOT NULL, \"meal\" TEXT NOT NULL, \"food_name\" TEXT NOT NULL, \"brand\" TEXT NOT NULL DEFAULT '', \"serving_label\" TEXT NOT NULL, \"amount\" REAL NOT NULL, \"kcal\" INTEGER NOT NULL, \"protein_g\" REAL NOT NULL, \"carbs_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"source\" TEXT NOT NULL, \"source_ref\" TEXT NULL, \"logged_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "water_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"water_logs\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"synced_at\" INTEGER NULL, \"server_updated_at\" INTEGER NULL, \"date\" TEXT NOT NULL UNIQUE, \"glasses\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "weight_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weight_entries\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"synced_at\" INTEGER NULL, \"server_updated_at\" INTEGER NULL, \"date\" TEXT NOT NULL, \"kg\" REAL NOT NULL, \"measured_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "custom_foods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_foods\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"synced_at\" INTEGER NULL, \"server_updated_at\" INTEGER NULL, \"name\" TEXT NOT NULL, \"brand\" TEXT NOT NULL DEFAULT '', \"serving_label\" TEXT NOT NULL, \"kcal_per_serving\" INTEGER NOT NULL, \"protein_g\" REAL NOT NULL, \"carbs_g\" REAL NOT NULL, \"fat_g\" REAL NOT NULL, \"category\" TEXT NOT NULL, \"barcode\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
